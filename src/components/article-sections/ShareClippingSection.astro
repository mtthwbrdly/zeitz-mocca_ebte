---
const { section } = Astro.props;
---

<section class="share-clipping" aria-label={section.label || "Share clipping"}>
  <p class="share-clipping__label">{section.label || "(+) Share Clipping"}</p>
  <blockquote>{section.quote}</blockquote>
</section>

<style>
  .share-clipping {
    position: relative;
    max-width: 58rem;
    margin-left: auto;
    padding: 2rem 2rem 2.4rem;
    border: 1px solid rgba(23, 23, 23, 0.14);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.92)),
      var(--surface-soft);
  }

  .share-clipping__label,
  .share-clipping blockquote {
    margin: 0;
  }

  .share-clipping__label {
    font: 400 0.78rem / 1.2 var(--font-meta);
    text-transform: uppercase;
    letter-spacing: var(--meta-letter-spacing);
  }

  .share-clipping blockquote {
    margin-top: 2.8rem;
    font: 400 clamp(2rem, 3.2vw, 2.65rem) / 1.06 var(--font-display);
    letter-spacing: -0.03em;
    text-align: center;
    text-wrap: balance;
  }
</style>
