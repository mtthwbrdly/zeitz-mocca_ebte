---
import { getCategoryIconSvg } from "../../lib/categoryIcons";
import { normalizeArticleCategory } from "../../sanity/lib/articleCategory";
import { cleanString } from "../../sanity/lib/clean";
import type { CategoryCardsHomeSection } from "../../sanity/lib/types";

interface Props {
  section?: CategoryCardsHomeSection;
}

const { section } = Astro.props;

const title = cleanString(section?.title) || "Categories";
const intro = cleanString(section?.intro);
const cards = section?.cards || [];

const categoryLabel = (category: NonNullable<(typeof cards)[number]["category"]>) => {
  if (category === "foot-note") return "foot notes";
  if (category === "voice-note") return "voice notes";
  return "process notes";
};

const categoryHref = (category: (typeof cards)[number]["category"]) =>
  `/articles?category=${cleanString(category) || "process-note"}`;
---

{
  cards.length > 0 && (
    <section class="home-categories" aria-labelledby="home-categories-title">
      <header class="home-categories__header">
        <h2
          class="section-title-row home-categories__title-row"
          id="home-categories-title"
        >
          <span>{title}</span>
        </h2>
      </header>
      {intro && (
        <div class="home-categories__intro">
          <p>{intro}</p>
        </div>
      )}

      <div class="home-categories__cards" role="list">
        {cards.map((card) => {
          const category = normalizeArticleCategory(card.category);
          const cardTitle = cleanString(card.title) || categoryLabel(category);
          const label = cleanString(card.label) || categoryLabel(category);
          // allow HTML (e.g. <em>) in descriptions — render via set:html below
          const description = card.description;
          const linkText =
            cleanString(card.linkText) || `All ${categoryLabel(category)}`;
          const iconSvg = getCategoryIconSvg(category);

          return (
            <article
              class={`home-category-card article-category-${category}`}
              role="listitem"
            >
              <h3 class="home-category-card__title">
                <span>{cardTitle}</span>
              </h3>
              <div class="home-category-card__content">
                <p class="home-category-card__label">{label}</p>
                {description && (
                  <p
                    class="home-category-card__description"
                    set:html={description}
                  />
                )}
                <a class="home-category-card__link" href={categoryHref(category)}>
                  {linkText}
                </a>
                <span
                  class="home-category-card__icon"
                  aria-hidden="true"
                  set:html={iconSvg}
                />
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )
}

<style>
  .home-categories {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.625rem);
    padding: 1.5rem 1.5rem 1.5rem 1.5rem;
    color: var(--ink);
  }

  .home-categories__header {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    min-height: 4rem;
    border: 1px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
  }

  .home-categories__header h2 {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 1rem clamp(1rem, 5vw, 4rem);
    border-right: 1px solid var(--ink);
    font: 700 clamp(1.1rem, 1.6vw, 1.55rem) / 1 var(--font-display);
    letter-spacing: 0;
    text-transform: uppercase;
    width: auto;
  }

  .home-categories__intro {
    padding: 2rem 4rem;
  }

  .home-categories__intro p {
    text-align: left;
    font: 400 clamp(1.5rem, 2.5vw, 3rem) / 1 var(--font-display);
    letter-spacing: 0;
    margin: 0;
  }

  .home-categories__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .home-category-card {
    --category-card-bg: var(--article-category-bg);
    position: relative;
    display: grid;
    min-height: clamp(24rem, 35vw, 32rem);
    overflow: hidden;
    border: 1px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
    isolation: isolate;
    aspect-ratio: 4/5;
  }

  .home-category-card__title {
    grid-area: 1 / 1;
    z-index: 5;
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    place-items: center;
    margin: 0;
    padding: clamp(1.25rem, 2.2vw, 2rem);
    color: var(--ink);
    font: 400 clamp(2.4rem, 4vw, 5.75rem) / 0.86 var(--font-display);
    letter-spacing: -0.02em;
    text-align: center;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .home-category-card__icon {
    display: block;
    width: clamp(2.5rem, 5vw, 5.5rem);
    color: var(--ink);
    position: absolute;
    right: clamp(1rem, 1.5vw, 2.5rem);
    bottom: clamp(1rem, 1.5vw, 2.5rem);
  }

  .home-category-card__icon :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .home-category-card__icon :global(svg *) {
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 0.15;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .home-category-card__content {
    grid-area: 1 / 1;
    z-index: 2;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.25rem, 2.5vw, 3rem);
    background: var(--category-card-bg);
    opacity: 0.025;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .home-category-card:hover .home-category-card__title,
  .home-category-card:focus-within .home-category-card__title {
    opacity: 0.025;
  }

  .home-category-card:hover .home-category-card__content,
  .home-category-card:focus-within .home-category-card__content {
    opacity: 1;
    pointer-events: auto;
  }

  .home-category-card__label {
    align-self: flex-start;
    margin: 0;
    padding: 0.35rem 0.5rem 0.375rem;
    background: var(--ink);
    color: var(--article-category-bg);
    font: 700 0.75rem / 1 var(--font-display);
    letter-spacing: var(--meta-letter-spacing);
    text-transform: uppercase;
  }

  .home-category-card__description {
    position: relative;
    z-index: 1;
    font: 400 clamp(0.85rem, 1.75vw, 2rem) / 1.15 var(--font-display);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .home-category-card__description em {
    text-shadow: var(--text-shadow-hover-small-black) !important;
    font-style: normal;
  }

  .home-category-card__link {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    padding: 0.35rem 0.55rem 0.35rem;
    color: var(--ink);
    font: 700 1rem / 1 var(--font-display);
    text-decoration: none;
    text-transform: uppercase;
    transition: var(--transition-text-shadow);
    margin-top: auto;
    border: 1px solid var(--ink);
  }

  .home-category-card__link:hover,
  .home-category-card__link:focus-visible {
    text-shadow: var(--text-shadow-hover-small-black);
    outline: 0;
    color: var(--article-category-bg);
    background: var(--ink);
  }

  @media (max-width: 900px) {

    .home-categories {
      padding: 1rem;
    }
    
    .home-categories__cards {
      grid-template-columns: 1fr;
      padding: 0rem;
    }

    .home-categories__header {
      display: grid;
      grid-template-columns: 1fr;
    }

    .home-categories__header h2 {
      border-right: 0;
      border-bottom: 1px solid var(--ink);
    }
    .home-category-card__description {
      font-size: clamp(1rem, 6vw, 1.25rem);
    }
    .home-category-card__content {
      padding: clamp(2rem, 2vw, 3rem);
    }
    .home-category-card__icon {
      bottom: 1rem;
      right: 1rem;
      width: clamp(5rem, 5vw, 5.5rem);
    }
    .home-category-card__link {
      font-size: 0.75rem;
    }
    .home-categories__header {
      border-bottom: 0px solid var(--ink);
    }
    .home-categories__intro {
      font: 400 clamp(1.5rem, 2.5vw, 3rem) / 1 var(--font-display);
      padding: 0.5rem 1rem 1rem;
    }
  }

  
</style>
