---
import { isFeatureEnabled, type FeatureFlag } from "../lib/featureFlags";

type NavLink = {
  href: string;
  label: string;
  featureFlag?: FeatureFlag;
};

const links: NavLink[] = [
  { href: "/", label: "Home" },
  { href: "/articles", label: "Index" },
  { href: "/authors", label: "Authors", featureFlag: "authorsIndex" },
  { href: "/", label: "Contact" },
].filter((link) => !link.featureFlag || isFeatureEnabled(link.featureFlag));
---

<div class="site-nav-shell">
  <nav class="site-nav" aria-label="Primary" transition:persist="site-nav" transition:animate="none">
    <a class="site-nav__brand" href="/">Everything but the Exhibition</a>
    <button
      class="site-nav__menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu-overlay"
      data-menu-toggle
    >
      Menu
    </button>
  </nav>

  <div class="site-menu-overlay" id="site-menu-overlay" aria-hidden="true" data-menu-overlay transition:persist="site-menu-overlay" transition:animate="none">
    <div class="site-menu-overlay__panel" role="dialog" aria-modal="true" aria-label="Site menu">
      <div class="site-menu-overlay__top">
        <a class="site-menu-overlay__brand" href="/" data-menu-link>Everything but the Exhibition</a>
        <button class="site-menu-overlay__close" type="button" aria-label="Close menu" data-menu-close>
          Close
        </button>
      </div>

      <div class="site-menu-overlay__content">
        <div class="site-menu-overlay__links">
          {links.map((link) => (
            <a href={link.href} data-menu-link>{link.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .site-nav-shell {
    display: contents;
  }

  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 998;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 1.5rem 1.5rem;
    mix-blend-mode: difference;
    color: #fff;
    pointer-events: auto;
    user-select: none;
  }

  .site-nav__brand,
  .site-nav__menu-button {
    color: inherit;
    text-decoration: none;
    font: 400 1.25rem / 1 var(--font-display);
    letter-spacing: -0.02em;
    font-weight: 600;
    transition: var(--transition-text-shadow);
  }

  .site-nav__brand:hover,
  .site-nav__menu-button:hover {
    text-shadow: var(--text-shadow-hover-small-white);
  }

  .site-nav__brand {
    text-transform: uppercase;
  }

  .site-nav__menu-button {
    appearance: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .site-nav__menu-button:focus-visible,
  .site-menu-overlay a:focus-visible,
  .site-menu-overlay button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.25rem;
  }

  .site-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    pointer-events: none;
    opacity: 0;
    background: var(--page-bg);
    color: var(--ink);
    transition: opacity 240ms ease;
    
  }

  .site-menu-overlay.is-open {
    pointer-events: auto;
    opacity: 1;
  }

  .site-menu-overlay__panel {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 1.5rem 1.5rem 1.5rem;
    backdrop-filter: blur(2px);
  }

  .site-menu-overlay__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .site-menu-overlay__brand,
  .site-menu-overlay__close {
    color: inherit;
    text-decoration: none;
    font: 400 1.25rem / 1 var(--font-display);
    letter-spacing: -0.02em;
    font-weight: 600;
    transition: var(--transition-text-shadow);
    user-select: none;
  }

   .site-menu-overlay__brand {
    text-transform: uppercase;
  }

  .site-menu-overlay__close {
    appearance: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .site-menu-overlay__brand:hover,
  .site-menu-overlay__close:hover {
    text-shadow: var(--text-shadow-hover-small-black);
  }

  .site-menu-overlay__content {
    align-self: end;
    display: grid;
    gap: 1.25rem;
    padding-top: 7rem;
  }

  .site-menu-overlay__links {
    display: grid;
    user-select: none;
  }

  .site-menu-overlay__links a {
    width: fit-content;
    color: inherit;
    text-decoration: none;
    font: 400 clamp(3.25rem, 11vw, 9rem) / 0.9 var(--font-display);
    letter-spacing: 0;
    transition: var(--transition-text-shadow);
  }

  .site-menu-overlay__links a:hover {
    text-shadow: var(--text-shadow-hover-large-black);
  }

  :global(body.site-menu-is-open) {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .site-nav {
      padding-block: 1rem;
      background: var(--article-category-bg);
      mix-blend-mode: normal;
      color: var(--ink);
      padding:1rem;
      border-bottom: 1px solid var(--ink);
    }

    .site-nav__brand,
    .site-nav__menu-button,
    .site-menu-overlay__brand,
    .site-menu-overlay__close {
      font-size: 1.1rem;
    }

    .site-menu-overlay__panel {
      padding: 1rem;
    }

    .site-menu-overlay__content {
      gap: 1rem;
      padding-top: 5rem;
    }

    .site-menu-overlay__links a {
      font-size: clamp(2.9rem, 18vw, 5.7rem);
    }
  }
</style>

<script>
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const menuOverlay = document.querySelector("[data-menu-overlay]");
  const menuClose = document.querySelector("[data-menu-close]");
  const menuLinks = document.querySelectorAll("[data-menu-link]");
  let previouslyFocusedElement = null;

  if (menuToggle instanceof HTMLButtonElement && menuToggle.dataset.menuBound !== "true") {
    menuToggle.dataset.menuBound = "true";

    const setMenuOpen = (isOpen) => {
      if (!(menuToggle instanceof HTMLButtonElement) || !(menuOverlay instanceof HTMLElement)) {
        return;
      }

      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuOverlay.setAttribute("aria-hidden", String(!isOpen));
      menuOverlay.classList.toggle("is-open", isOpen);
      document.body.classList.toggle("site-menu-is-open", isOpen);

      if (isOpen) {
        previouslyFocusedElement = document.activeElement;
        window.lenis?.stop?.();
        menuClose?.focus();
        return;
      }

      window.lenis?.start?.();
      if (previouslyFocusedElement instanceof HTMLElement) {
        previouslyFocusedElement.focus();
      }
    };

    menuToggle.addEventListener("click", () => setMenuOpen(true));
    menuClose?.addEventListener("click", () => setMenuOpen(false));
    menuLinks.forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menuOverlay?.classList.contains("is-open")) {
        setMenuOpen(false);
      }
    });
  }
</script>
