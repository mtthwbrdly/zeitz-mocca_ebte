---
import { isFeatureEnabled, type FeatureFlag } from "../lib/featureFlags";
import menuLogoUrl from "../assets/zeitz-logo-icon_dark.svg?url";

type NavLink = {
  href: string;
  label: string;
  featureFlag?: FeatureFlag;
};

const links: NavLink[] = [
  { href: "/", label: "Home" },
  { href: "/articles", label: "Index" },
  { href: "/authors", label: "Authors", featureFlag: "authorsIndex" },
  { href: "/", label: "Contact" },
].filter((link) => !link.featureFlag || isFeatureEnabled(link.featureFlag));
---

<div class="site-nav-shell">
  <nav
    class="site-nav"
    aria-label="Primary"
    transition:persist="site-nav"
    transition:animate="none"
  >
    <a class="site-nav__brand" href="/">Everything but the Exhibition</a>
    <button
      class="site-nav__menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu-overlay"
      data-menu-toggle
    >
      Menu
    </button>
  </nav>

  <div
    class="site-menu-overlay"
    id="site-menu-overlay"
    aria-hidden="true"
    data-menu-overlay
    transition:persist="site-menu-overlay"
    transition:animate="none"
  >
    <div
      class="site-menu-overlay__panel"
      role="dialog"
      aria-modal="true"
      aria-label="Site menu"
    >
      <div class="site-menu-overlay__top">
        <a class="site-menu-overlay__brand" href="/" data-menu-link
          >Everything but the Exhibition</a
        >
        <button
          class="site-menu-overlay__close"
          type="button"
          aria-label="Close menu"
          data-menu-close
        >
          Close
        </button>
      </div>

      <div class="site-menu-overlay__content">
        <div class="site-menu-overlay__links">
          {
            links.map((link) => (
              <a href={link.href} data-menu-link>
                {link.label}
              </a>
            ))
          }
        </div>
        <div class="site-menu-overlay__logo">
          <a
            class="site-menu-overlay__logo-link"
            href="https://zeitzmocaa.museum/"
            aria-label="ZEITZ MOCAA"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              class="site-menu-overlay__logo"
              src={menuLogoUrl}
              alt="ZEITZ MOCAA"
              width="169"
              height="40"
              loading="lazy"
            />
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .site-nav-shell {
    display: contents;
  }

  .site-nav {
    display: contents;
  }

  .site-nav__brand,
  .site-nav__menu-button {
    position: fixed;
    top: 1.5rem;
    z-index: 998;
    mix-blend-mode: difference;
    color: #fff;
    text-decoration: none;
    font: 400 1.25rem / 1 var(--font-display);
    letter-spacing: -0.02em;
    font-weight: 600;
    pointer-events: auto;
    transition: var(--transition-text-shadow);
    user-select: none;
  }

  .site-nav__brand:hover,
  .site-nav__menu-button:hover {
    text-shadow: var(--text-shadow-hover-small-white);
  }

  .site-nav__brand {
    left: 1.5rem;
    text-transform: uppercase;
  }

  .site-nav__menu-button {
    right: 1.5rem;
    appearance: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    z-index: 1000;
  }

  .site-nav__menu-button:focus-visible,
  .site-menu-overlay a:focus-visible,
  .site-menu-overlay button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.25rem;
  }

  .site-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 1001;
    display: grid;
    height: var(--site-menu-viewport-height, 100dvh);
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    background: var(--page-bg);
    color: var(--ink);
    transition: opacity 240ms ease;
  }

  .site-menu-overlay.is-open {
    pointer-events: auto;
    opacity: 1;
  }

  .site-menu-overlay__panel {
    height: 100%;
    min-height: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.5rem 1.5rem 1.5rem;
    backdrop-filter: blur(2px);
  }

  .site-menu-overlay__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .site-menu-overlay__brand,
  .site-menu-overlay__close {
    color: inherit;
    text-decoration: none;
    font: 400 1.25rem / 1 var(--font-display);
    letter-spacing: -0.02em;
    font-weight: 600;
    transition: var(--transition-text-shadow);
    user-select: none;
  }

  .site-menu-overlay__brand {
    text-transform: uppercase;
  }

  .site-menu-overlay__close {
    appearance: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .site-menu-overlay__brand:hover,
  .site-menu-overlay__close:hover {
    text-shadow: var(--text-shadow-hover-small-black);
  }

  .site-menu-overlay__content {
    align-self: end;
    display: grid;
    gap: 1.25rem;
    padding-top: 7rem;
    position: relative;
  }

  .site-menu-overlay__links {
    display: grid;
    user-select: none;
  }

  .site-menu-overlay__links a {
    width: fit-content;
    color: inherit;
    text-decoration: none;
    font: 400 clamp(3.25rem, 14vw, 17rem) / 0.8 var(--font-display);
    letter-spacing: -0.02em;
    transition: var(--transition-text-shadow);
    padding: 0.25rem;
    overflow: hidden;
  }

  .site-menu-overlay__links a:hover {
    text-shadow: var(--text-shadow-hover-large-black);
  }

  :global(body.site-menu-is-open) {
    overflow: hidden;
    touch-action: none;
  }

  .site-menu-overlay__logo {
    position: absolute;
    bottom: 0;
    right: 0;
  }

  .site-menu-overlay__logo img {
    fill: var(--ink);
  }

  .site-menu-overlay__logo {
    width: clamp(2rem, 6vw, 8rem);
    height: auto;
  }

  @media (max-width: 900px) {
    .site-nav__brand,
    .site-nav__menu-button,
    .site-menu-overlay__brand,
    .site-menu-overlay__close {
      font-size: 1.1rem;
    }

    .site-nav__brand,
    .site-nav__menu-button {
      top: 1rem;
    }

    .site-nav__brand {
      display: none;
    }

    .site-menu-overlay__brand {
      display: none;
    }

    .site-nav__menu-button {
      right: 1rem;
    }

      .site-menu-overlay__close {
        position: fixed;
        top: 1rem;
        right: 1rem;
      }

    .site-menu-overlay__panel {
      padding: 1rem;
    }

    .site-menu-overlay__content {
      gap: 1rem;
      padding-top: 5rem;
    }

    .site-menu-overlay__links a {
      font-size: clamp(2.9rem, 25vw, 8rem);
    }

    .site-menu-overlay__logo {
      width: clamp(4rem, 8vw, 8rem);
      height: auto;
      position: fixed;
      top: 1rem;
      left: 1rem;
    }
  }
</style>

<script>
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const menuOverlay = document.querySelector("[data-menu-overlay]");
  const menuClose = document.querySelector("[data-menu-close]");
  const menuLinks = document.querySelectorAll("[data-menu-link]");
  let previouslyFocusedElement = null;

  if (
    menuToggle instanceof HTMLButtonElement &&
    menuToggle.dataset.menuBound !== "true"
  ) {
    menuToggle.dataset.menuBound = "true";

    const setMenuViewportHeight = () => {
      const viewportHeight = window.visualViewport?.height || window.innerHeight;
      document.documentElement.style.setProperty(
        "--site-menu-viewport-height",
        `${viewportHeight}px`,
      );
    };

    const lockPageScroll = () => {
      const lockedScrollY = window.scrollY;
      document.body.dataset.siteMenuScrollY = String(lockedScrollY);
      document.body.style.position = "fixed";
      document.body.style.top = `-${lockedScrollY}px`;
      document.body.style.left = "0";
      document.body.style.right = "0";
      document.body.style.width = "100%";
      document.body.style.overflow = "hidden";
      document.documentElement.style.overflow = "hidden";
    };

    const unlockPageScroll = () => {
      const wasLocked =
        document.body.classList.contains("site-menu-is-open") ||
        document.body.dataset.siteMenuScrollY !== undefined ||
        document.body.style.position === "fixed";
      const lockedScrollY = Number(document.body.dataset.siteMenuScrollY || "0");
      delete document.body.dataset.siteMenuScrollY;
      document.body.classList.remove("site-menu-is-open");
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.left = "";
      document.body.style.right = "";
      document.body.style.width = "";
      document.body.style.overflow = "";
      document.documentElement.style.overflow = "";
      if (wasLocked) {
        window.scrollTo(0, lockedScrollY);
      }
    };

    const setMenuOpen = (isOpen) => {
      if (
        !(menuToggle instanceof HTMLButtonElement) ||
        !(menuOverlay instanceof HTMLElement)
      ) {
        return;
      }

      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuOverlay.setAttribute("aria-hidden", String(!isOpen));
      menuOverlay.classList.toggle("is-open", isOpen);
      document.body.classList.toggle("site-menu-is-open", isOpen);

      if (isOpen) {
        previouslyFocusedElement = document.activeElement;
        setMenuViewportHeight();
        lockPageScroll();
        window.lenis?.stop?.();
        menuClose?.focus();
        return;
      }

      unlockPageScroll();
      if (!document.body.classList.contains("article-sidebar-panel-is-open")) {
        window.lenis?.start?.();
      }
      if (previouslyFocusedElement instanceof HTMLElement) {
        previouslyFocusedElement.focus();
      }
    };

    menuToggle.addEventListener("click", () => setMenuOpen(true));
    menuClose?.addEventListener("click", () => setMenuOpen(false));
    menuLinks.forEach((link) =>
      link.addEventListener("click", () => setMenuOpen(false)),
    );

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        menuOverlay?.classList.contains("is-open")
      ) {
        setMenuOpen(false);
      }
    });

    window.addEventListener("pagehide", unlockPageScroll);
    window.addEventListener("pageshow", () => {
      if (!menuOverlay.classList.contains("is-open")) {
        unlockPageScroll();
      }
    });
    document.addEventListener("astro:before-swap", unlockPageScroll);

    window.visualViewport?.addEventListener("resize", setMenuViewportHeight);
    window.visualViewport?.addEventListener("scroll", setMenuViewportHeight);
    window.addEventListener("resize", setMenuViewportHeight);
    setMenuViewportHeight();
  }
</script>
